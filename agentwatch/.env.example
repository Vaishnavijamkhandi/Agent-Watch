# Database: SQLite by default; PostgreSQL URL works with psycopg installed.
DATABASE_URL=sqlite:///./agentwatch.db
AGENTWATCH_SECRET=replace-with-a-long-random-server-secret
AGENTWATCH_ADMIN_TOKEN=
AGENTWATCH_DEMO=1
AGENTWATCH_DEMO_TOKEN=aw_demo_token
HALF_LIFE_HOURS=24
RISK_HOLD_THRESHOLD=12
RISK_QUARANTINE_THRESHOLD=20
ALLOWED_EMAIL_DOMAINS=company.local,approved-vendor.example
OPENAI_API_KEY=
AGENTWATCH_LLM_MODEL=gpt-4o-mini
AGENTWATCH_RATE_LIMIT_PER_MINUTE=60
